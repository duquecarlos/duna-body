#!/usr/bin/env bash
# duna-deploy-body -- root-owned entry point for Body's deploy on duna-prod-1 (host-deploy-v1).
# Installed to /usr/local/sbin/duna-deploy-body; called only as:
#   sudo -n /usr/local/sbin/duna-deploy-body <status|deploy [--dry-run]|pull|backup [--dry-run]|
#     importar-pc --cuenta-sub <sub> --archivo <path> [--apply]|personas|rollback-script>
set -Eeuo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  echo "duna-deploy-body: refused -- must run as root (EUID 0)" >&2
  exit 1
fi

PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

REPO_DIR="/srv/duna/repos/duna-body"
PRODUCT_SCRIPT="$REPO_DIR/deploy/host/body-deploy.sh"
PRODUCT_BACKUP_SCRIPT="$REPO_DIR/deploy/host/body-backup.sh"
PRODUCT_IMPORT_SCRIPT="$REPO_DIR/deploy/host/body-import-pc.sh"
DATA_DIR="/srv/duna/data/body"
DATA_USER="duna-body"

usage() {
  cat >&2 <<'USAGE'
usage: duna-deploy-body <command>
  status              show unit status, deployed sha, data dir mode;
                      exits 3 if the last backup run failed
  deploy [--dry-run]  pull the repo and redeploy (--dry-run: print the plan, run nothing);
                      the entry script and its sudoers rule update themselves on every deploy
  pull                run today's full Garmin pull now (body-pull.service), then print its journal
  backup [--dry-run]  snapshot, encrypt and upload to R2, delete the plaintext (--dry-run: print the plan, run nothing)
  importar-pc --cuenta-sub <sub> --archivo <path> [--apply]
                      import one person's PC snapshot into this host (dry run by default)
  personas            list hosted persons by cuenta_sub, display name and first consent
  rollback-script     restore the entry script and its sudoers rule from their .prev backups
USAGE
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

cmd="$1"
shift

DRY_RUN=""

run() {
  if [[ -n "$DRY_RUN" ]]; then
    printf '%s\n' "$*"
  else
    "$@"
  fi
}

ensure_system_user() {
  if ! id "$DATA_USER" >/dev/null 2>&1; then
    run useradd --system --user-group --no-create-home --shell /usr/sbin/nologin "$DATA_USER"
  fi
}

ensure_data_dir() {
  run mkdir -p "$DATA_DIR"
  run chown "$DATA_USER:$DATA_USER" "$DATA_DIR"
  run chmod 0700 "$DATA_DIR"
}

case "$cmd" in
  status)
    if [[ $# -ne 0 ]]; then
      usage
      exit 2
    fi
    if [[ ! -d "$REPO_DIR" ]]; then
      echo "duna-deploy-body: repo not found at $REPO_DIR" >&2
      exit 1
    fi
    owner="$(stat -c %U "$REPO_DIR")"
    # body-deploy.sh is the single list of Body's live units (BODY-DEPLOY-HOST-1); sourcing it
    # stops before it runs any deploy step (its own sourced-vs-executed guard).
    source "$PRODUCT_SCRIPT"
    for unit in body-web.service "${TIMERS[@]}"; do
      state="$(run systemctl is-active "$unit" 2>/dev/null || true)"
      echo "$unit: $state"
    done
    sha="$(runuser -u "$owner" -- git -C "$REPO_DIR" rev-parse HEAD)"
    echo "deployed sha: $sha"
    status_exit=0
    for job_unit in body-backup.service body-pull.service body-backfill.service; do
      job_last_run="$(run systemctl show -p ExecMainExitTimestamp --value "$job_unit" 2>/dev/null || true)"
      echo "$job_unit last run: ${job_last_run:-never}"
      if [[ -n "$job_last_run" ]]; then
        job_result="$(run systemctl show -p Result --value "$job_unit" 2>/dev/null || true)"
        job_exit_status="$(run systemctl show -p ExecMainStatus --value "$job_unit" 2>/dev/null || true)"
        if [[ "$job_result" == "success" ]]; then
          echo "$job_unit last result: success"
        else
          echo "$job_unit last result: FAILED (${job_result}, exit ${job_exit_status})"
          if [[ "$job_unit" == "body-backup.service" ]]; then
            status_exit=3
          fi
        fi
      fi
    done
    if [[ -d "$DATA_DIR" ]]; then
      echo "data dir: $DATA_DIR mode $(stat -c %a "$DATA_DIR") owner $(stat -c %U "$DATA_DIR")"
    else
      echo "data dir: $DATA_DIR (not yet created)"
    fi
    exit "$status_exit"
    ;;
  deploy)
    AUTOACTUALIZADO_INTERNO=""
    CARRIED_BEFORE_SHA=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --dry-run)
          DRY_RUN="1"
          shift
          ;;
        --autoactualizado-interno)
          AUTOACTUALIZADO_INTERNO="1"
          shift
          ;;
        --before-sha)
          CARRIED_BEFORE_SHA="${2:-}"
          shift 2
          ;;
        *)
          usage
          exit 2
          ;;
      esac
    done
    if [[ -n "$AUTOACTUALIZADO_INTERNO" && -z "$CARRIED_BEFORE_SHA" ]]; then
      usage
      exit 2
    fi
    if [[ -z "$AUTOACTUALIZADO_INTERNO" && -n "$CARRIED_BEFORE_SHA" ]]; then
      usage
      exit 2
    fi
    if [[ -n "$AUTOACTUALIZADO_INTERNO" && -n "$DRY_RUN" ]]; then
      usage
      exit 2
    fi
    ;;
  backup)
    if [[ $# -gt 1 ]]; then
      usage
      exit 2
    fi
    if [[ $# -eq 1 ]]; then
      if [[ "$1" != "--dry-run" ]]; then
        usage
        exit 2
      fi
      DRY_RUN="1"
    fi
    ;;
  pull)
    if [[ $# -ne 0 ]]; then
      usage
      exit 2
    fi
    ;;
  importar-pc)
    # body-import-pc.sh itself validates --cuenta-sub, --archivo and --apply.
    ;;
  personas)
    if [[ $# -ne 0 ]]; then
      usage
      exit 2
    fi
    ;;
  rollback-script)
    if [[ $# -ne 0 ]]; then
      usage
      exit 2
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac

if [[ ! -d "$REPO_DIR" ]]; then
  echo "duna-deploy-body: repo not found at $REPO_DIR" >&2
  exit 1
fi

if [[ "$cmd" == "backup" ]]; then
  if [[ -n "$DRY_RUN" ]]; then
    exec /bin/bash "$PRODUCT_BACKUP_SCRIPT" --dry-run
  fi
  exec /bin/bash "$PRODUCT_BACKUP_SCRIPT"
fi

if [[ "$cmd" == "pull" ]]; then
  # BODY-SYNC-VIVO-TIMER-1 ruling 3: runs the SAME daily full pull body-pull.timer runs at 09:30,
  # waits for it (--wait), then prints exactly that run's own journal lines -- never a figure, the
  # job's own counts-only print lines. Exit status is the service's own.
  inicio="$(date '+%Y-%m-%d %H:%M:%S')"
  estado=0
  run systemctl start --wait body-pull.service || estado=$?
  journalctl -u body-pull --since "$inicio" -o cat
  exit "$estado"
fi

if [[ "$cmd" == "importar-pc" ]]; then
  exec /bin/bash "$PRODUCT_IMPORT_SCRIPT" importar-pc "$@"
fi

if [[ "$cmd" == "personas" ]]; then
  exec /bin/bash "$PRODUCT_IMPORT_SCRIPT" personas
fi

if [[ "$cmd" == "rollback-script" ]]; then
  source "$REPO_DIR/deploy/host/autoactualizar.sh"
  if [[ ! -f "$PREV_SCRIPT_PATH" || ! -f "$PREV_SUDOERS_PATH" ]]; then
    echo "rollback-script: refused -- missing .prev backup" >&2
    exit 1
  fi
  if ! visudo -cf "$PREV_SUDOERS_PATH" >/dev/null 2>&1; then
    echo "rollback-script: refused -- .prev sudoers file fails visudo -cf" >&2
    exit 1
  fi
  run install -o root -g root -m 0755 "$PREV_SCRIPT_PATH" "$INSTALLED_SCRIPT_PATH"
  run install -o root -g root -m 0440 "$PREV_SUDOERS_PATH" "$INSTALLED_SUDOERS_PATH"
  echo "rollback-script: restored $INSTALLED_SCRIPT_PATH and $INSTALLED_SUDOERS_PATH from their .prev backups"
  exit 0
fi

owner="$(stat -c %U "$REPO_DIR")"

ensure_system_user
ensure_data_dir

if [[ -n "$DRY_RUN" ]]; then
  echo "runuser -u \"$owner\" -- git -C \"$REPO_DIR\" rev-parse HEAD"
  echo "runuser -u \"$owner\" -- git -C \"$REPO_DIR\" fetch origin"
  echo "runuser -u \"$owner\" -- git -C \"$REPO_DIR\" pull --ff-only"
  source "$REPO_DIR/deploy/host/autoactualizar.sh"
  autoactualizar_plan "$REPO_DIR/deploy/host/duna-deploy-body" "$REPO_DIR/deploy/host/duna-deploy-body.sudoers"
  echo "exec /bin/bash \"$PRODUCT_SCRIPT\" --before-sha <captured-sha>"
  exit 0
fi

if [[ -z "$AUTOACTUALIZADO_INTERNO" ]]; then
  before_sha="$(runuser -u "$owner" -- git -C "$REPO_DIR" rev-parse HEAD)"
  runuser -u "$owner" -- git -C "$REPO_DIR" fetch origin
  runuser -u "$owner" -- git -C "$REPO_DIR" pull --ff-only

  source "$REPO_DIR/deploy/host/autoactualizar.sh"
  autoactualizar_comparar "$REPO_DIR/deploy/host/duna-deploy-body" "$REPO_DIR/deploy/host/duna-deploy-body.sudoers"
  if [[ -n "$SCRIPT_CHANGED" || -n "$SUDOERS_CHANGED" ]]; then
    autoactualizar_instalar "$REPO_DIR/deploy/host/duna-deploy-body" "$REPO_DIR/deploy/host/duna-deploy-body.sudoers"
    exec "$INSTALLED_SCRIPT_PATH" deploy --autoactualizado-interno --before-sha "$before_sha"
  fi
  echo "entry script: up to date"
else
  before_sha="$CARRIED_BEFORE_SHA"
fi

exec /bin/bash "$PRODUCT_SCRIPT" --before-sha "$before_sha"
