# Body app's host env file -- written by Carlos at /srv/duna/env/body.env (root:duna-body, mode
# 0640). No value belongs in this repo; this file names each variable and how it is generated.

# Cuenta Duna's OIDC client secret for Body's "body" client. Never typed by hand: Main's
# host-deploy-v1 walk-through (section 3) pipes Cuenta's own secret-generation step straight into
# this file.
BODY_CUENTA_CLIENT_SECRET=

# Cuenta Duna's issuer. Fixed for every Duna product on duna-prod-1.
BODY_CUENTA_ISSUER=https://cuenta.duna.solutions

# Body's own public URL, behind Caddy.
BODY_PUBLIC_URL=https://body.duna.solutions

# Encrypts the Garmin token file at rest in BODY_HOME. Generate with: openssl rand -hex 32
BODY_TOKEN_KEY=

# The age public key backups are encrypted to (BODY-HOST-BACKUP-1). Starts with age1...
BODY_BACKUP_AGE_RECIPIENT=

# Cloudflare R2 credentials for off-host backup (BODY-HOST-BACKUP-1).
BODY_R2_ACCESS_KEY_ID=
BODY_R2_SECRET_ACCESS_KEY=
BODY_R2_ENDPOINT=
BODY_R2_BUCKET=duna-respaldo

# body/agente/cliente.py, Body's own assistant client (BODY-ASISTENTE-PROVEEDORES-1). Every
# provider below is available at once, turned on by ITS OWN KEY ALONE -- the model line already
# carries Duna's AI model standard (modelos-ia-v1, docs/contracts/modelos-ia-v1.md) as its code
# default, the same model locally and on the server, so leaving it blank still runs the standard;
# set it only to run a different model for that provider. With no key at all, the assistant
# answers "not configured" and the app still starts. Blank BODY_AGENTE_PROVEEDOR means "anthropic",
# the default; it picks among whichever providers are configured (falls back to the first
# configured). The person can choose their own in Ajustes when two or more are configured.
BODY_AGENTE_PROVEEDOR=

# Anthropic API key. Model defaults to claude-sonnet-5-5 (modelos-ia-v1); set to run a different one.
BODY_AGENTE_ANTHROPIC_API_KEY=
BODY_AGENTE_MODELO_ANTHROPIC=claude-sonnet-5-5

# OpenAI API key. Model defaults to gpt-6.1-sol (modelos-ia-v1); set to run a different one.
BODY_AGENTE_OPENAI_API_KEY=
BODY_AGENTE_MODELO_OPENAI=gpt-6.1-sol

# Gemini API key. Model defaults to gemini-3.8-flash (modelos-ia-v1); set to run a different one.
BODY_AGENTE_GEMINI_API_KEY=
BODY_AGENTE_MODELO_GEMINI=gemini-3.8-flash

# Growth's public media base URL for tutoriales-v1 (BODY-TUTORIALES-2): body/tutoriales.py fetches
# "{this}/body/manifest.json" server-side. With no value, Ayuda still renders every task, each
# showing "Video en preparación" in place of a video.
BODY_TUTORIALES_BASE_URL=
