# body.duna.solutions -- Body's reverse proxy site on duna-prod-1 (host-deploy-v1).
# No `log` directive on purpose: Caddy access logging for this site stays off; Body logs path
# templates only (never a full URL or query string), in body/web.py.
# Assumes the host's main Caddyfile imports /etc/caddy/sites/* -- an ASSUMPTION Main confirms in
# the walk-through, not confirmed yet.
body.duna.solutions {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}

	respond /login/cuenta/logout-token 404

	reverse_proxy 127.0.0.1:8770
}
