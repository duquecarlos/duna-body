# Body app's LOCAL file for the assistant, on YOUR PC. Copy this file to ".env" next to it, paste
# your keys below, then restart the "Body app web" task (or just rerun `python -m body.web`).
#
# Only lines whose name starts with BODY_AGENTE_ are read from this file -- everything else here
# is ignored. A name already set in your real environment (PowerShell `$env:`, or a Windows user
# variable) always wins over this file.
#
# The hosted server uses a different file instead: deploy/host/body.env.example ->
# /srv/duna/env/body.env. Nothing here ever needs to match that file's secrets.

BODY_AGENTE_PROVEEDOR=anthropic
BODY_AGENTE_ANTHROPIC_API_KEY=
BODY_AGENTE_MODELO_ANTHROPIC=claude-sonnet-5-5
BODY_AGENTE_OPENAI_API_KEY=
BODY_AGENTE_MODELO_OPENAI=gpt-6.1-sol
BODY_AGENTE_GEMINI_API_KEY=
BODY_AGENTE_MODELO_GEMINI=gemini-3.8-flash
